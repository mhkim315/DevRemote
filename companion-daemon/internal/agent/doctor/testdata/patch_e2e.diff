+package v3_0_0
+import "testing"
+import "devremote/companion-daemon/internal/agent"
+import "devremote/companion-daemon/internal/agent/contract"
+func TestConformance(t *testing.T) {
+\tfx := contract.ConformanceFixtures{
+\t\tDetectContext:    contract.SessionContext{SessionID: "s", ProcessName: "claude", CWD: "/tmp/.claude"},
+\t\tExpectDetectKind: "claude",
+\t\tValidRecords:     []contract.RawRecord{{Bytes: []byte("{\\"id\\":\\"e1\\",\\"kind\\":\\"message\\",\\"ts\\":1}"), Source: agent.SourceJSONL, Provenance: contract.ProvenanceNativeLog}},
+\t\tExpectTypes:      []contract.AgentEventType{agent.EventAssistantMessage},
+\t\tDistinctRecord: func(i int) contract.RawRecord {
+\t\t\ts := string(rune('0' + i%10))
+\t\t\treturn contract.RawRecord{Bytes: []byte("{\\"id\\":\\"d" + s + "\\",\\"kind\\":\\"message\\",\\"ts\\":" + s + "}"), Source: agent.SourceJSONL, Provenance: contract.ProvenanceNativeLog}
+\t\t},
+\t\tSizedRecord: func(size int) contract.RawRecord {
+\t\t\tif size < 40 { size = 40 }
+\t\t\treturn contract.RawRecord{Bytes: append([]byte("{\\"id\\":\\"sz\\",\\"kind\\":\\"message\\",\\"ts\\":0,\\"text\\":\\""), make([]byte, size-40)...), Source: agent.SourceJSONL, Provenance: contract.ProvenanceNativeLog}
+\t\t},
+\t\tFailingFactory:   func(t *testing.T) contract.AgentAdapter { return &Adapter{} },
+\t\tApprovalRecords:  []contract.RawRecord{{Bytes: []byte("{\\"id\\":\\"a1\\",\\"kind\\":\\"approval\\",\\"ts\\":5}"), Source: agent.SourceJSONL, Provenance: contract.ProvenanceNativeLog}},
+\t}
+\tcontract.RunAgentContract(t, "claude-v3", func(t *testing.T) contract.AgentAdapter { return &Adapter{} }, fx)
+}
